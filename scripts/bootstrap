#!/bin/sh
set -eu

SCRIPT_PATH=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$SCRIPT_PATH" 2>/dev/null || true)
  if [ -n "$resolved" ]; then SCRIPT_PATH=$resolved; fi
fi
SCRIPT_DIR=$(CDPATH= cd "$(dirname "$SCRIPT_PATH")" && pwd)
ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)

fail() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }
info() { printf '==> %s\n' "$1"; }
require_command() { command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"; }

require_command node
require_command npm
require_command cp
require_command cmp
require_command diff
require_command mkdir
require_command ln
require_command chmod
require_command mv

if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit((major === 22 && minor >= 19) || major >= 24 ? 0 : 1)'; then
  fail "unsupported Node.js $(node --version); expected ^22.19.0 or >=24.0.0"
fi

EXPECTED_PNPM=$(node -p "require('$ROOT/package.json').packageManager.split('@').pop()")
EXPECTED_DSH=$(node -p "require('$ROOT/package.json').dependencies['@deepseek-ai/dsh']")
PROFILE_PACKAGE="$ROOT/profiles/engineering/package.json"
PROFILE_RUNTIME_PACKAGES='@deepseek-ai/dsh-terminal @deepseek-ai/dsh-terminal-bash @deepseek-ai/dsh-tool-terminal'

if command -v pnpm >/dev/null 2>&1 && [ "$(pnpm --version)" = "$EXPECTED_PNPM" ]; then
  info "pnpm $EXPECTED_PNPM already active"
else
  info "activating pnpm $EXPECTED_PNPM"
  if command -v corepack >/dev/null 2>&1; then
    corepack prepare "pnpm@$EXPECTED_PNPM" --activate
  else
    npm install --global "pnpm@$EXPECTED_PNPM"
  fi
fi
[ "$(pnpm --version)" = "$EXPECTED_PNPM" ] || fail "pnpm version mismatch after activation"

info "verifying pinned DSH $EXPECTED_DSH exists in the npm registry"
if ! REGISTRY_DSH=$(pnpm view "@deepseek-ai/dsh@$EXPECTED_DSH" version 2>/dev/null); then
  fail "pinned @deepseek-ai/dsh@$EXPECTED_DSH is not available from the configured npm registry"
fi
[ "$REGISTRY_DSH" = "$EXPECTED_DSH" ] || fail "registry resolved unexpected DSH version: expected $EXPECTED_DSH, got $REGISTRY_DSH"

info 'verifying pinned engineering profile runtime dependencies exist in the npm registry'
for pkg in $PROFILE_RUNTIME_PACKAGES; do
  expected=$(node -p "require('$PROFILE_PACKAGE').dependencies['$pkg'] || ''")
  [ -n "$expected" ] || fail "engineering profile does not pin required runtime dependency: $pkg"
  if ! actual=$(pnpm view "$pkg@$expected" version 2>/dev/null); then
    fail "pinned profile runtime dependency $pkg@$expected is not available from the configured npm registry"
  fi
  [ "$actual" = "$expected" ] || fail "registry resolved unexpected $pkg version: expected $expected, got $actual"
done

info "installing repository dependencies"
cd "$ROOT"
LOCKFILE_TRACKED=false
if command -v git >/dev/null 2>&1 && git -C "$ROOT" ls-files --error-unmatch pnpm-lock.yaml >/dev/null 2>&1; then
  LOCKFILE_TRACKED=true
fi
if [ "$LOCKFILE_TRACKED" = true ]; then
  [ -f pnpm-lock.yaml ] || fail "pnpm-lock.yaml is tracked by Git but missing from the working tree"
  pnpm install --frozen-lockfile
else
  if [ -f pnpm-lock.yaml ]; then
    printf 'WARN: local untracked pnpm-lock.yaml is not canonical yet; refreshing it from exact direct pins.\n' >&2
  else
    printf 'WARN: pnpm-lock.yaml is not committed yet; installing from exact direct pins.\n' >&2
  fi
  pnpm install --no-frozen-lockfile
fi

DSH_BIN="$ROOT/node_modules/.bin/dsh"
[ -x "$DSH_BIN" ] || fail "local dsh executable was not installed"
ACTUAL_DSH=$($DSH_BIN --version 2>&1)
case "$ACTUAL_DSH" in
  *"$EXPECTED_DSH"*) ;;
  *) fail "dsh version mismatch: expected $EXPECTED_DSH, got $ACTUAL_DSH" ;;
esac

PROFILE_SRC="$ROOT/profiles/engineering"
info 'installing engineering profile runtime dependencies from the canonical locked workspace graph'
for pkg in $PROFILE_RUNTIME_PACKAGES; do
  [ -e "$PROFILE_SRC/node_modules/$pkg" ] || fail "profile runtime dependency missing after pnpm install: $pkg"
done

DSH_HOME=${DSH_HOME:-"$HOME/.dsh"}
DSH_AGENTS_HOME=${DSH_AGENTS_HOME:-"$HOME/.agents"}
PROFILE_DST="$DSH_HOME/profiles/engineering"
PRESET_SRC="$ROOT/agent-presets/matspectrum-engineering"
PRESET_DST="$DSH_HOME/.agent-presets/matspectrum-engineering"
SKILLS_MANIFEST="$ROOT/manifests/managed-skills.txt"
SKILLS_SRC="$ROOT/.agents/skills"
SKILLS_DST="$DSH_AGENTS_HOME/skills"

[ -f "$SKILLS_MANIFEST" ] || fail "managed skills manifest missing: $SKILLS_MANIFEST"
mkdir -p "$PROFILE_DST" "$PRESET_DST" "$SKILLS_DST"
chmod 700 "$PRESET_DST"

STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR=""
SKILL_BACKUP_DIR=""

ensure_backup_dir() {
  if [ -z "$BACKUP_DIR" ]; then
    BACKUP_DIR="$DSH_HOME/backups/engineering-$STAMP"
    mkdir -p "$BACKUP_DIR"
  fi
}

ensure_skill_backup_dir() {
  if [ -z "$SKILL_BACKUP_DIR" ]; then
    SKILL_BACKUP_DIR="$DSH_AGENTS_HOME/backups/matspectrum-engineering-$STAMP"
    mkdir -p "$SKILL_BACKUP_DIR"
  fi
}

sync_runtime_file() {
  src=$1
  dst=$2
  backup_name=$3
  description=$4

  [ -f "$src" ] || fail "canonical file missing: $src"
  if [ -f "$dst" ] && ! cmp -s "$src" "$dst"; then
    ensure_backup_dir
    cp -p "$dst" "$BACKUP_DIR/$backup_name"
    info "backed up divergent $description: $dst"
  fi
  cp "$src" "$dst"
}

sync_skill_bundle() {
  skill=$1
  src="$SKILLS_SRC/$skill"
  dst="$SKILLS_DST/$skill"

  [ -d "$src" ] || fail "canonical managed skill directory missing: $src"
  [ -f "$src/SKILL.md" ] || fail "canonical managed skill file missing: $src/SKILL.md"

  if [ -d "$dst" ] && [ ! -L "$dst" ] && diff -qr "$src" "$dst" >/dev/null 2>&1; then
    return
  fi

  if [ -e "$dst" ] || [ -L "$dst" ]; then
    ensure_skill_backup_dir
    mv "$dst" "$SKILL_BACKUP_DIR/$skill"
    info "backed up divergent managed skill: $dst"
  fi

  cp -R "$src" "$dst"
  chmod 700 "$dst"
  chmod 600 "$dst/SKILL.md"
}

info "materializing canonical engineering profile into $PROFILE_DST"
for name in package.json cordis.patch.yml pnpm-workspace.yaml; do
  sync_runtime_file "$PROFILE_SRC/$name" "$PROFILE_DST/$name" "profile-$name" "profile file"
done

PROFILE_NODE_MODULES_SRC="$PROFILE_SRC/node_modules"
PROFILE_NODE_MODULES_DST="$PROFILE_DST/node_modules"
expected_modules_target=$(readlink -f "$PROFILE_NODE_MODULES_SRC" 2>/dev/null || true)
if [ -L "$PROFILE_NODE_MODULES_DST" ]; then
  current_modules_target=$(readlink -f "$PROFILE_NODE_MODULES_DST" 2>/dev/null || true)
  if [ "$current_modules_target" != "$expected_modules_target" ]; then
    ensure_backup_dir
    mv "$PROFILE_NODE_MODULES_DST" "$BACKUP_DIR/profile-node_modules"
    ln -s "$PROFILE_NODE_MODULES_SRC" "$PROFILE_NODE_MODULES_DST"
    info 'replaced divergent profile node_modules link'
  fi
elif [ -e "$PROFILE_NODE_MODULES_DST" ]; then
  ensure_backup_dir
  mv "$PROFILE_NODE_MODULES_DST" "$BACKUP_DIR/profile-node_modules"
  ln -s "$PROFILE_NODE_MODULES_SRC" "$PROFILE_NODE_MODULES_DST"
  info 'backed up unmanaged profile node_modules and installed managed link'
else
  ln -s "$PROFILE_NODE_MODULES_SRC" "$PROFILE_NODE_MODULES_DST"
  info 'installed managed engineering profile node_modules link'
fi

info "materializing canonical matspectrum-engineering preset into $PRESET_DST"
for name in agent.cordis.yml preset.yml; do
  sync_runtime_file "$PRESET_SRC/$name" "$PRESET_DST/$name" "preset-$name" "agent preset file"
  chmod 600 "$PRESET_DST/$name"
done

info "materializing canonical engineering skills into $SKILLS_DST"
while IFS= read -r skill || [ -n "$skill" ]; do
  [ -n "$skill" ] || continue
  case "$skill" in
    *[!a-z0-9-]*|'') fail "invalid managed skill name in manifest: $skill" ;;
  esac
  sync_skill_bundle "$skill"
done < "$SKILLS_MANIFEST"

info "validating composed engineering profile"
DSH_HOME="$DSH_HOME" DSH_AGENTS_HOME="$DSH_AGENTS_HOME" "$DSH_BIN" --profile engineering --dump-config >/dev/null

BIN_DIR=${DSH_ENGINEERING_BIN_DIR:-"$HOME/.local/bin"}
LAUNCHER="$BIN_DIR/dsh-engineering"
CANONICAL_LAUNCHER="$ROOT/bin/dsh-engineering"
mkdir -p "$BIN_DIR"

if [ -e "$LAUNCHER" ] || [ -L "$LAUNCHER" ]; then
  existing=$(readlink -f "$LAUNCHER" 2>/dev/null || true)
  canonical=$(readlink -f "$CANONICAL_LAUNCHER" 2>/dev/null || true)
  if [ -z "$existing" ] || [ "$existing" != "$canonical" ]; then
    fail "$LAUNCHER already exists and is not managed by this repository"
  fi
else
  ln -s "$CANONICAL_LAUNCHER" "$LAUNCHER"
  info "installed launcher: $LAUNCHER"
fi

if command -v dsh >/dev/null 2>&1; then
  GLOBAL_DSH=$(command -v dsh)
  printf 'INFO: another dsh is visible at %s; dsh-engineering always uses the repository-pinned runtime.\n' "$GLOBAL_DSH"
fi

info "running doctor"
DSH_HOME="$DSH_HOME" DSH_AGENTS_HOME="$DSH_AGENTS_HOME" DSH_ENGINEERING_BIN_DIR="$BIN_DIR" sh "$ROOT/scripts/doctor"

case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) printf 'WARN: %s is not in PATH; add it before invoking dsh-engineering by name.\n' "$BIN_DIR" >&2 ;;
esac

printf '\nBootstrap complete. Use: dsh-engineering\n'
