#!/bin/sh
set -eu

SCRIPT_PATH=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$SCRIPT_PATH" 2>/dev/null || true)
  if [ -n "$resolved" ]; then SCRIPT_PATH=$resolved; fi
fi
SCRIPT_DIR=$(CDPATH= cd "$(dirname "$SCRIPT_PATH")" && pwd)
ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)

failures=0
warnings=0

pass() { printf 'PASS: %s\n' "$1"; }
warn() { printf 'WARN: %s\n' "$1" >&2; warnings=$((warnings + 1)); }
fail() { printf 'FAIL: %s\n' "$1" >&2; failures=$((failures + 1)); }
check_command() { command -v "$1" >/dev/null 2>&1; }

run_quiet_probe() {
  if check_command timeout; then
    timeout 20 "$@" >/dev/null 2>&1
  else
    "$@" >/dev/null 2>&1
  fi
}

check_optional_cli_auth() {
  cli=$1
  label=$2
  shift 2

  if ! check_command "$cli"; then
    warn "$label CLI is not installed"
    return
  fi

  if run_quiet_probe "$@"; then
    pass "$label CLI is installed and authentication is verified"
  else
    warn "$label CLI is installed, but authentication could not be verified non-interactively"
  fi
}

check_omniroute() {
  endpoint='http://127.0.0.1:20128/v1/models'

  if [ -z "${OMNIROUTE_API_KEY:-}" ]; then
    warn 'OMNIROUTE_API_KEY is not defined; OmniRoute end-to-end validation is unavailable'
    return
  fi

  if ! check_command curl; then
    warn 'curl is not installed; OmniRoute endpoint cannot be validated'
    return
  fi

  tmp=$(mktemp)
  if ! curl -fsS --connect-timeout 2 --max-time 10 \
    -H "Authorization: Bearer $OMNIROUTE_API_KEY" \
    "$endpoint" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    warn 'OmniRoute is configured but http://127.0.0.1:20128/v1/models is unreachable or rejected the credential'
    return
  fi

  pass 'OmniRoute local /v1/models endpoint is reachable with the configured credential'

  if ! node -e 'const fs=require("fs"); try { const v=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.exit(Array.isArray(v.data)?0:1) } catch { process.exit(1) }' "$tmp"; then
    rm -f "$tmp"
    warn 'OmniRoute /v1/models did not return the expected OpenAI-compatible JSON catalog'
    return
  fi

  pass 'OmniRoute model catalog is valid OpenAI-compatible JSON'

  if node -e 'const fs=require("fs"); const v=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); const ids=new Set(v.data.map(x=>x&&x.id)); process.exit(ids.has("auto/best-coding")?0:1)' "$tmp"; then
    pass 'OmniRoute advertises the default auto/best-coding route'
  else
    fail 'OmniRoute is reachable but the required default auto/best-coding route is missing'
  fi

  if node -e 'const fs=require("fs"); const v=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); const ids=new Set(v.data.map(x=>x&&x.id)); process.exit(ids.has("auto/coding:reliable")?0:1)' "$tmp"; then
    pass 'OmniRoute advertises the auto/coding:reliable fallback route'
  else
    warn 'OmniRoute does not currently advertise the auto/coding:reliable fallback route'
  fi

  rm -f "$tmp"
}

validate_canonical_skill() {
  skill=$1
  path=$2

  if [ ! -f "$path" ]; then
    fail "canonical managed skill is missing: $path"
    return
  fi

  case "$skill" in
    *[!a-z0-9-]*|'')
      fail "managed skill name is not kebab-case: $skill"
      return
      ;;
  esac

  frontmatter_name=$(awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && /^name:[[:space:]]*/ {
      sub(/^name:[[:space:]]*/, "")
      print
      exit
    }
  ' "$path")

  frontmatter_description=$(awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && /^description:[[:space:]]*/ {
      sub(/^description:[[:space:]]*/, "")
      print
      exit
    }
  ' "$path")

  if [ "$frontmatter_name" = "$skill" ]; then
    pass "canonical skill frontmatter name matches bundle directory: $skill"
  else
    fail "canonical skill frontmatter name mismatch for $skill: ${frontmatter_name:-missing}"
  fi

  if [ -n "$frontmatter_description" ]; then
    pass "canonical skill has required description: $skill"
  else
    fail "canonical skill description is missing or empty: $skill"
  fi
}

check_managed_skills() {
  manifest="$ROOT/manifests/managed-skills.txt"
  canonical_root="$ROOT/.agents/skills"
  runtime_root="$DSH_AGENTS_HOME/skills"

  if [ ! -f "$manifest" ]; then
    fail "managed skills manifest is missing: $manifest"
    return
  fi

  if ! check_command diff; then
    fail 'diff is required to validate managed skill bundle drift'
    return
  fi

  count=0
  while IFS= read -r skill || [ -n "$skill" ]; do
    [ -n "$skill" ] || continue
    count=$((count + 1))
    canonical_bundle="$canonical_root/$skill"
    canonical_file="$canonical_bundle/SKILL.md"
    runtime_bundle="$runtime_root/$skill"

    validate_canonical_skill "$skill" "$canonical_file"

    if [ ! -d "$runtime_bundle" ]; then
      fail "runtime managed skill bundle is missing: $runtime_bundle"
    elif diff -qr "$canonical_bundle" "$runtime_bundle" >/dev/null 2>&1; then
      pass "runtime managed skill matches repository canonical state: $skill"
    else
      fail "runtime managed skill has drifted from repository canonical state: $skill"
    fi
  done < "$manifest"

  if [ "$count" -gt 0 ]; then
    pass "managed skills manifest contains $count skill(s)"
  else
    fail 'managed skills manifest is empty'
  fi
}

printf '%s\n' 'DSH Engineering Stack Doctor'
printf '%s\n' '----------------------------'

if check_command node; then
  NODE_VERSION=$(node --version)
  if node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit((major === 22 && minor >= 19) || major >= 24 ? 0 : 1)'; then
    pass "Node.js $NODE_VERSION is supported"
  else
    fail "Node.js $NODE_VERSION is unsupported; expected ^22.19.0 or >=24.0.0"
  fi
else
  fail 'Node.js is not installed'
fi

if check_command node; then
  EXPECTED_PNPM=$(node -p "require('$ROOT/package.json').packageManager.split('@').pop()")
  EXPECTED_DSH=$(node -p "require('$ROOT/package.json').dependencies['@deepseek-ai/dsh']")
else
  EXPECTED_PNPM='unknown'
  EXPECTED_DSH='unknown'
fi

if check_command pnpm; then
  ACTUAL_PNPM=$(pnpm --version)
  if [ "$ACTUAL_PNPM" = "$EXPECTED_PNPM" ]; then
    pass "pnpm $ACTUAL_PNPM matches the pinned version"
  else
    fail "pnpm $ACTUAL_PNPM does not match pinned $EXPECTED_PNPM"
  fi
else
  fail 'pnpm is not installed'
fi

DSH_BIN="$ROOT/node_modules/.bin/dsh"
if [ -x "$DSH_BIN" ]; then
  ACTUAL_DSH=$($DSH_BIN --version 2>&1)
  case "$ACTUAL_DSH" in
    *"$EXPECTED_DSH"*) pass "local DSH runtime matches pinned $EXPECTED_DSH" ;;
    *) fail "local DSH runtime mismatch: expected $EXPECTED_DSH, got $ACTUAL_DSH" ;;
  esac
else
  fail "local DSH runtime is missing; run $ROOT/scripts/bootstrap"
fi

DSH_HOME=${DSH_HOME:-"$HOME/.dsh"}
DSH_AGENTS_HOME=${DSH_AGENTS_HOME:-"$HOME/.agents"}
PROFILE_SRC="$ROOT/profiles/engineering"
PROFILE_DST="$DSH_HOME/profiles/engineering"
PRESET_SRC="$ROOT/agent-presets/matspectrum-engineering"
PRESET_DST="$DSH_HOME/.agent-presets/matspectrum-engineering"
PROFILE_RUNTIME_PACKAGES='@deepseek-ai/dsh-terminal @deepseek-ai/dsh-terminal-bash @deepseek-ai/dsh-tool-terminal'
METHODOLOGY_PLUGIN_SRC="$PROFILE_SRC/plugins/methodology-guard.mjs"
METHODOLOGY_PLUGIN_DST="$PROFILE_DST/plugins/methodology-guard.mjs"
SKILLS_MANIFEST_SRC="$ROOT/manifests/managed-skills.txt"
PROFILE_SKILLS_MANIFEST_DST="$PROFILE_DST/managed-skills.txt"

for name in package.json cordis.patch.yml pnpm-workspace.yaml; do
  if [ ! -f "$PROFILE_DST/$name" ]; then
    fail "runtime profile file missing: $PROFILE_DST/$name"
  elif cmp -s "$PROFILE_SRC/$name" "$PROFILE_DST/$name"; then
    pass "runtime profile $name matches repository canonical state"
  else
    fail "runtime profile $name has drifted from repository canonical state"
  fi
done

if [ ! -f "$METHODOLOGY_PLUGIN_DST" ]; then
  fail "runtime methodology guard is missing: $METHODOLOGY_PLUGIN_DST"
elif cmp -s "$METHODOLOGY_PLUGIN_SRC" "$METHODOLOGY_PLUGIN_DST"; then
  pass 'runtime methodology guard matches repository canonical state'
else
  fail 'runtime methodology guard has drifted from repository canonical state'
fi

if [ ! -f "$PROFILE_SKILLS_MANIFEST_DST" ]; then
  fail "runtime profile managed-Skills manifest is missing: $PROFILE_SKILLS_MANIFEST_DST"
elif cmp -s "$SKILLS_MANIFEST_SRC" "$PROFILE_SKILLS_MANIFEST_DST"; then
  pass 'runtime profile managed-Skills manifest matches repository canonical state'
else
  fail 'runtime profile managed-Skills manifest has drifted from repository canonical state'
fi

if [ -f "$METHODOLOGY_PLUGIN_DST" ] && node --input-type=module -e 'import { pathToFileURL } from "node:url"; await import(pathToFileURL(process.argv[1]).href)' "$METHODOLOGY_PLUGIN_DST" >/dev/null 2>&1; then
  pass 'runtime methodology guard imports successfully'
else
  fail 'runtime methodology guard cannot be imported'
fi

PROFILE_NODE_MODULES_SRC="$PROFILE_SRC/node_modules"
PROFILE_NODE_MODULES_DST="$PROFILE_DST/node_modules"
if [ -L "$PROFILE_NODE_MODULES_DST" ]; then
  installed_modules=$(readlink -f "$PROFILE_NODE_MODULES_DST" 2>/dev/null || true)
  canonical_modules=$(readlink -f "$PROFILE_NODE_MODULES_SRC" 2>/dev/null || true)
  if [ -n "$installed_modules" ] && [ "$installed_modules" = "$canonical_modules" ]; then
    pass 'engineering profile node_modules points to the canonical locked workspace graph'
  else
    fail 'engineering profile node_modules link points somewhere else'
  fi
else
  fail 'engineering profile node_modules is not the managed runtime link'
fi

# Unlike --dump-config, these probes actually exercise Node package resolution
# from the same profile directory used when DSH mounts a user-owned agent preset.
for pkg in $PROFILE_RUNTIME_PACKAGES; do
  if (cd "$PROFILE_DST" && node --input-type=module -e 'await import(process.argv[1])' "$pkg") >/dev/null 2>&1; then
    pass "profile runtime dependency imports successfully: $pkg"
  else
    fail "profile runtime dependency cannot be imported from engineering profile: $pkg"
  fi
done

for name in agent.cordis.yml preset.yml; do
  if [ ! -f "$PRESET_DST/$name" ]; then
    fail "runtime agent preset file missing: $PRESET_DST/$name"
  elif cmp -s "$PRESET_SRC/$name" "$PRESET_DST/$name"; then
    pass "runtime matspectrum-engineering preset $name matches repository canonical state"
  else
    fail "runtime matspectrum-engineering preset $name has drifted from repository canonical state"
  fi
done

check_managed_skills

if [ -x "$DSH_BIN" ] && [ -f "$PROFILE_DST/package.json" ]; then
  DUMP_FILE=$(mktemp)
  DUMP_ERR=$(mktemp)
  trap 'rm -f "$DUMP_FILE" "$DUMP_ERR"' EXIT HUP INT TERM
  if DSH_HOME="$DSH_HOME" DSH_AGENTS_HOME="$DSH_AGENTS_HOME" "$DSH_BIN" --profile engineering --dump-config >"$DUMP_FILE" 2>"$DUMP_ERR"; then
    pass 'engineering profile composes successfully'

    if grep -Fq 'web-startup' "$DUMP_FILE" || grep -Fq '@deepseek-ai/dsh-web-app' "$DUMP_FILE"; then
      pass 'official DSH Web UI surface is present in the composed profile'
    else
      fail 'composed engineering profile does not expose the expected Web UI surface'
    fi

    if grep -Fq 'methodology-guard' "$DUMP_FILE" || grep -Fq './plugins/methodology-guard.mjs' "$DUMP_FILE"; then
      pass 'native methodology guard is present in the composed profile'
    else
      fail 'native methodology guard is missing from the composed profile'
    fi

    if grep -Fq '@deepseek-ai/dsh-terminal' "$DUMP_FILE"; then
      pass 'persistent terminal registry is present in the composed profile'
    else
      fail 'persistent terminal registry is missing from the composed profile'
    fi

    if grep -Fq '@deepseek-ai/dsh-terminal-bash' "$DUMP_FILE"; then
      pass 'local Bash PTY backend is present in the composed profile'
    else
      fail 'local Bash PTY backend is missing from the composed profile'
    fi

    if grep -Fq 'matspectrum-engineering' "$DUMP_FILE"; then
      pass 'matspectrum-engineering is selected by the engineering profile'
    else
      fail 'matspectrum-engineering default preset is missing from the composed profile'
    fi

    if grep -Fq 'provider: omniroute' "$DUMP_FILE" && grep -Fq 'model: auto/best-coding' "$DUMP_FILE"; then
      pass 'OmniRoute auto/best-coding is the composed default model route'
    else
      fail 'composed engineering profile does not select OmniRoute auto/best-coding by default'
    fi
  else
    fail "engineering profile does not compose: $(tr '\n' ' ' < "$DUMP_ERR")"
  fi
fi

BIN_DIR=${DSH_ENGINEERING_BIN_DIR:-"$HOME/.local/bin"}
LAUNCHER="$BIN_DIR/dsh-engineering"
CANONICAL_LAUNCHER="$ROOT/bin/dsh-engineering"
if [ -L "$LAUNCHER" ]; then
  installed=$(readlink -f "$LAUNCHER" 2>/dev/null || true)
  canonical=$(readlink -f "$CANONICAL_LAUNCHER" 2>/dev/null || true)
  if [ -n "$installed" ] && [ "$installed" = "$canonical" ]; then
    pass 'dsh-engineering launcher points to this repository'
  else
    fail 'dsh-engineering launcher points somewhere else'
  fi
elif [ -e "$LAUNCHER" ]; then
  fail "$LAUNCHER exists but is not the managed symlink"
else
  fail "$LAUNCHER is not installed"
fi

if check_command git; then
  pass "git is available ($(git --version))"
else
  fail 'git is required for the engineering stack'
fi

# Presence and authentication are deliberately separate states. Probe output is
# discarded so tokens, account metadata, or project names never enter doctor logs.
check_optional_cli_auth gh 'GitHub' gh auth status
check_optional_cli_auth supabase 'Supabase' supabase projects list
check_optional_cli_auth vercel 'Vercel' vercel whoami

check_omniroute

printf '\nSummary: %d failure(s), %d warning(s).\n' "$failures" "$warnings"
if [ "$failures" -ne 0 ]; then exit 1; fi
exit 0
